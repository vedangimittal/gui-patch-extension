{
  "manifest_version": 3,
  "name": "Remote Deployment Tool",
  "version": "1.0.0",
  "description": "Chrome/Edge extension to deploy builds to remote machines",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png",
    "default_title": "Remote Deployment"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": []
}